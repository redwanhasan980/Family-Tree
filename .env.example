# Copy to .env.local and fill in. Never commit real values (DESIGN §27.2).
# With NEXT_PUBLIC_USE_EMULATORS=true the app runs against the local Emulator Suite
# and the Firebase values below may stay empty.

# --- Client (inlined into the browser bundle) ---
NEXT_PUBLIC_USE_EMULATORS=true
# Optional: host the browser uses to reach the emulators (default 127.0.0.1).
NEXT_PUBLIC_EMULATOR_HOST=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
# In production, use the app's own domain (DESIGN §9.5).
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# reCAPTCHA v3 site key for App Check (production only).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# base64 of the service-account JSON: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# dev | prod — selects the Cloudinary folder prefix shikor/{env}/
APP_ENV=dev
# Authorizes Vercel Cron calls (v1.1+).
CRON_SECRET=
GUEST_RETENTION_DAYS=365
