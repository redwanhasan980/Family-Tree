# /opt/shikor/.env — server settings for শিকড় (Shikor). Keep it chmod 600; never commit real values.
# NEXT_PUBLIC_* values are not here: they are baked into the image at build time from
# GitHub repository variables (see docs/DEPLOYMENT.md).

# Your domain once its DNS A record points to this server (for example: shikor.app, www.shikor.app).
# ":80" serves plain HTTP on the server's IP for a first test; Google sign-in needs the domain.
SITE_ADDRESS=:80

# Image version currently running. Managed by deploy.sh; do not edit by hand.
IMAGE_TAG=latest

# --- Server-only secrets (DESIGN §27.2) ---
# base64 of the Firebase service-account JSON: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
APP_ENV=prod
CRON_SECRET=
GUEST_RETENTION_DAYS=365
