rules_version = '2';

// Phase 0 baseline: deny all client access. The full rules from DESIGN §8 land in P2-05,
// and every allow/deny path is covered by tests in firebase/tests (NFR-SEC-01).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
