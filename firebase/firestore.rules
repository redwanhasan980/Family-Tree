rules_version = '2';

// Security rules (DESIGN §8). Every allow/deny path is covered by tests in firebase/tests.
// Cross-document graph integrity (loops, one biological father) is checked by the domain
// layer before each write, not here: rules may only read 20 documents per batch.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isGuestToken() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function optBool(d, k) { return !(k in d) || d[k] is bool; }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function treePath(treeId) { return /databases/$(database)/documents/trees/$(treeId); }
    // Reads use the tree as it is. Writes use the tree as it will be after the batch, so a
    // new tree and its first person can be written together.
    function roleNow(treeId) { return get(treePath(treeId)).data.roles.get(me(), ''); }
    function roleAfter(treeId) { return getAfter(treePath(treeId)).data.roles.get(me(), ''); }
    function canRead(treeId) { return signedIn() && roleNow(treeId) in ['owner', 'editor', 'viewer']; }
    function canEdit(treeId) { return signedIn() && roleAfter(treeId) in ['owner', 'editor']; }

    // Every write is stamped by its author with the server time.
    function stamped(d) { return d.updatedBy == me() && d.updatedAt == request.time; }
    // New documents may carry an earlier creation time: undo restores deleted ones as they were.
    function newStamps(d) {
      return d.createdAt is timestamp && d.createdAt <= request.time
        && d.createdBy is string && d.createdBy.size() <= 128
        && stamped(d) && d.schemaVersion == 1;
    }
    function keptStamps() {
      return request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && stamped(request.resource.data) && request.resource.data.schemaVersion == 1;
    }

    // ---------- users/{uid}: each user reads and writes only their own profile ----------
    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && validUser(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActiveAt == request.time;
      allow update: if signedIn() && me() == uid
        && validUser(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (!changedKeys().hasAny(['lastActiveAt']) || request.resource.data.lastActiveAt == request.time);
      allow delete: if false; // server only (guest merge, account deletion)
    }

    // ---------- trees ----------
    match /trees/{treeId} {
      allow get: if signedIn() && resource.data.roles.get(me(), '') != '';
      allow list: if signedIn() && me() in resource.data.memberIds;
      allow create: if signedIn()
        && validTree(request.resource.data)
        && request.resource.data.ownerId == me()
        && request.resource.data.memberIds == [me()]
        && request.resource.data.roles.keys().hasOnly([me()])
        && request.resource.data.createdAt == request.time
        && stamped(request.resource.data);
      allow update: if signedIn()
        && validTree(request.resource.data) && stamped(request.resource.data)
        && (ownerUpdate() || editorUpdate() || selfLeave());
      // Removing the people inside is the server's job (recursive delete, P3).
      allow delete: if signedIn() && resource.data.ownerId == me();

      // The owner may change everything except ownership and creation time, may remove
      // members or change their roles, but never adds members: invites do that (R3).
      function ownerUpdate() {
        return resource.data.ownerId == me()
          && !changedKeys().hasAny(['ownerId', 'createdAt'])
          && request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0;
      }
      function editorUpdate() {
        return resource.data.roles.get(me(), '') == 'editor'
          && changedKeys().hasOnly(['name', 'description', 'rootPersonId', 'settings', 'personCount',
                                    'updatedAt', 'updatedBy']);
      }
      function selfLeave() {
        return me() in resource.data.memberIds && resource.data.ownerId != me()
          && changedKeys().hasOnly(['memberIds', 'roles', 'updatedAt', 'updatedBy'])
          && request.resource.data.memberIds.toSet() == resource.data.memberIds.toSet().difference([me()].toSet());
      }

      match /persons/{personId} {
        allow read: if canRead(treeId);
        allow create: if canEdit(treeId)
          && validPerson(request.resource.data, treeId, personId) && newStamps(request.resource.data);
        allow update: if canEdit(treeId)
          && validPerson(request.resource.data, treeId, personId) && keptStamps();
        allow delete: if canEdit(treeId);
      }

      match /relationships/{relId} {
        allow read: if canRead(treeId);
        allow create: if canEdit(treeId)
          && validRelationship(relId, request.resource.data) && newStamps(request.resource.data);
        allow update: if canEdit(treeId)
          && validRelationship(relId, request.resource.data) && keptStamps();
        allow delete: if canEdit(treeId);
      }

      // Activity log (R3, SHR-07): append-only, written in the same batch as each change.
      match /activity/{entryId} {
        allow read: if canRead(treeId);
        allow create: if canEdit(treeId) && validActivity(request.resource.data);
        allow update, delete: if false; // pruned by the server
      }
    }

    // ---------- share links and invites (R3; read by the server with the Admin SDK) ----------
    match /shareLinks/{shareId} {
      allow read, delete: if signedIn() && resource.data.createdBy == me();
      allow create: if signedIn() && validShareLink(request.resource.data)
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && get(treePath(request.resource.data.treeId)).data.ownerId == me();
      allow update: if signedIn() && resource.data.createdBy == me()
        && validShareLink(request.resource.data)
        && changedKeys().hasOnly(['enabled', 'options']);
    }

    match /invites/{inviteId} {
      allow read, delete: if signedIn() && resource.data.createdBy == me();
      allow create: if signedIn() && !isGuestToken() && request.auth.token.email_verified == true
        && validInvite(request.resource.data)
        && request.resource.data.createdBy == me()
        && get(treePath(request.resource.data.treeId)).data.ownerId == me();
      allow update: if false; // accepted on the server
    }

    // mergeTickets, rateLimits and anything else: no client access.
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- validators ----------
    function validUser(u) {
      return u.keys().hasAll(['isGuest', 'locale', 'theme', 'createdAt', 'lastActiveAt', 'schemaVersion'])
        && u.keys().hasOnly(['isGuest', 'displayName', 'email', 'photoURL', 'locale', 'theme',
                             'selfPersonIds', 'onboardingCompleted', 'createdAt', 'lastActiveAt',
                             'schemaVersion'])
        // A profile is a guest exactly when the signed-in account is anonymous.
        && u.isGuest == isGuestToken()
        && u.locale in ['bn', 'en']
        && u.theme in ['system', 'light', 'dark']
        && optStr(u, 'displayName', 80)
        && optStr(u, 'photoURL', 2048)
        && (!('email' in u) || (u.email is string && u.email == request.auth.token.email))
        && (!('selfPersonIds' in u) || u.selfPersonIds is map)
        && optBool(u, 'onboardingCompleted')
        && u.schemaVersion == 1;
    }

    function validTree(t) {
      return t.keys().hasAll(['name', 'ownerId', 'memberIds', 'roles', 'personCount', 'settings',
                              'createdAt', 'updatedAt', 'updatedBy', 'schemaVersion'])
        && t.keys().hasOnly(['name', 'description', 'ownerId', 'memberIds', 'roles', 'rootPersonId',
                             'personCount', 'settings', 'createdAt', 'updatedAt', 'updatedBy',
                             'schemaVersion'])
        && t.name is string && t.name.size() >= 1 && t.name.size() <= 80
        && optStr(t, 'description', 500)
        && optStr(t, 'rootPersonId', 40)
        && t.memberIds is list && t.memberIds.size() >= 1 && t.memberIds.size() <= 50
        && t.roles is map && t.roles.keys().toSet() == t.memberIds.toSet()
        && t.roles.values().toSet().difference(['owner', 'editor', 'viewer'].toSet()).size() == 0
        && t.roles.get(t.ownerId, '') == 'owner'
        && t.personCount is int && t.personCount >= 0 && t.personCount <= 5000
        && validSettings(t.settings)
        && t.schemaVersion == 1;
    }

    function validSettings(s) {
      return s is map
        && s.keys().hasOnly(['nameDisplay', 'colorBy', 'showPhotos', 'showDates', 'defaultView', 'kinshipStyle'])
        && s.keys().hasAll(['nameDisplay', 'colorBy', 'showPhotos', 'showDates', 'defaultView', 'kinshipStyle'])
        && s.nameDisplay in ['auto', 'en', 'bn', 'both']
        && s.colorBy in ['branch', 'gender', 'generation', 'none']
        && s.showPhotos is bool && s.showDates is bool
        && s.defaultView in ['tree', 'family', 'circle', 'list', 'album', 'timeline']
        && s.kinshipStyle in ['bd', 'wb'];
    }

    // Partial dates: year only, year and month, or a full date (SRS §6.2).
    function validDate(d) {
      return d is map && d.keys().hasAll(['year']) && d.keys().hasOnly(['year', 'month', 'day', 'approximate'])
        && d.year is int && d.year >= 1000 && d.year <= request.time.year() + 1
        && (!('month' in d) || (d.month is int && d.month >= 1 && d.month <= 12))
        && (!('day' in d) || ('month' in d && d.day is int && d.day >= 1 && d.day <= 31))
        && optBool(d, 'approximate');
    }

    function validEvent(d, k) {
      return !(k in d) || (d[k] is map && d[k].keys().hasOnly(['date', 'place'])
        && (!('date' in d[k]) || validDate(d[k].date))
        && optStr(d[k], 'place', 120));
    }

    function validPhone(list, i) {
      return list.size() <= i || (list[i] is string && list[i].size() >= 1 && list[i].size() <= 30);
    }

    function validPerson(p, treeId, personId) {
      return p.keys().hasAll(['names', 'gender', 'isLiving', 'createdAt', 'createdBy',
                              'updatedAt', 'updatedBy', 'schemaVersion'])
        && p.keys().hasOnly(['names', 'nickname', 'gender', 'isLiving', 'birth', 'death',
                             'profession', 'education', 'addresses', 'phones', 'email',
                             'description', 'photo', 'customFields', 'childOrder',
                             'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion'])
        && p.names is map && p.names.keys().hasOnly(['en', 'bn'])
        && optStr(p.names, 'en', 120) && optStr(p.names, 'bn', 120)
        && (p.names.get('en', '').size() > 0 || p.names.get('bn', '').size() > 0)
        && p.gender in ['male', 'female', 'unknown'] && p.isLiving is bool
        && optStr(p, 'nickname', 60) && optStr(p, 'profession', 120) && optStr(p, 'education', 120)
        && optStr(p, 'email', 254) && optStr(p, 'description', 2000)
        && validEvent(p, 'birth') && validEvent(p, 'death')
        && (!('addresses' in p) || (p.addresses is map && p.addresses.keys().hasOnly(['present', 'permanent'])
            && optStr(p.addresses, 'present', 300) && optStr(p.addresses, 'permanent', 300)))
        && (!('phones' in p) || (p.phones is list && p.phones.size() <= 3
            && validPhone(p.phones, 0) && validPhone(p.phones, 1) && validPhone(p.phones, 2)))
        && (!('customFields' in p) || (p.customFields is list && p.customFields.size() <= 20))
        && (!('childOrder' in p) || p.childOrder is number)
        && (!('photo' in p) || p.photo == null
            || (p.photo is map && p.photo.keys().hasOnly(['publicId', 'version', 'width', 'height'])
                && p.photo.publicId is string
                && p.photo.publicId.matches('^shikor/[a-z]+/' + treeId + '/' + personId + '/[A-Za-z0-9_-]+$')
                && p.photo.version is int && p.photo.width is int && p.photo.height is int));
    }

    function validRelationship(relId, r) {
      return (r.type == 'parent'
          && r.keys().hasAll(['type', 'parentId', 'childId', 'kind', 'createdAt', 'createdBy',
                              'updatedAt', 'updatedBy', 'schemaVersion'])
          && r.keys().hasOnly(['type', 'parentId', 'childId', 'kind',
                               'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion'])
          && r.parentId is string && r.childId is string && r.parentId != r.childId
          && relId == 'p_' + r.parentId + '_' + r.childId
          && r.kind in ['biological', 'adoptive', 'step', 'foster'])
        || (r.type == 'spouse'
          && r.keys().hasAll(['type', 'personIds', 'status', 'createdAt', 'createdBy',
                              'updatedAt', 'updatedBy', 'schemaVersion'])
          && r.keys().hasOnly(['type', 'personIds', 'status', 'marriageDate', 'sequence',
                               'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'schemaVersion'])
          && r.personIds is list && r.personIds.size() == 2
          && r.personIds[0] is string && r.personIds[1] is string && r.personIds[0] < r.personIds[1]
          && relId == 's_' + r.personIds[0] + '_' + r.personIds[1]
          && r.status in ['married', 'divorced', 'separated', 'widowed']
          && (!('marriageDate' in r) || validDate(r.marriageDate))
          && (!('sequence' in r) || (r.sequence is int && r.sequence >= 1 && r.sequence <= 50)));
    }

    function validActivity(a) {
      return a.keys().hasAll(['actorId', 'action', 'targetType', 'at'])
        && a.keys().hasOnly(['actorId', 'action', 'targetType', 'targetId', 'summary', 'at'])
        && a.actorId == me() && a.at == request.time
        && a.action is string && a.action.size() <= 64
        && a.targetType in ['person', 'relationship', 'tree']
        && optStr(a, 'targetId', 128) && optStr(a, 'summary', 300);
    }

    function validShareLink(s) {
      return s.keys().hasOnly(['treeId', 'createdBy', 'createdAt', 'enabled', 'options'])
        && s.treeId is string && s.enabled is bool
        && s.options is map && s.options.keys().hasOnly(['hideContactInfo', 'hideLivingDetails', 'allowExport'])
        && optBool(s.options, 'hideContactInfo') && optBool(s.options, 'hideLivingDetails')
        && optBool(s.options, 'allowExport');
    }

    function validInvite(i) {
      return i.keys().hasOnly(['treeId', 'role', 'createdBy', 'createdAt', 'expiresAt', 'maxUses',
                               'uses', 'revoked'])
        && i.treeId is string && i.role in ['editor', 'viewer']
        && i.createdAt == request.time
        && i.expiresAt is timestamp && i.expiresAt > request.time
        && i.maxUses is int && i.maxUses >= 1 && i.maxUses <= 100
        && i.uses == 0 && i.revoked == false;
    }
  }
}
